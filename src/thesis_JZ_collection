import cv2
import mediapipe as mp
import numpy as np
import os
import time

# === Settings ===
SEQUENCE_LENGTH = 50       # Number of frames per gesture
RECORD_TIME = 3            # Time in seconds to record each gesture
LABELS = ["J", "Z"]        # Dynamic ASL gestures
SAVE_PATH = "dynamic_sign_data"

# === Setup directories ===
os.makedirs(SAVE_PATH, exist_ok=True)
for label in LABELS:
    os.makedirs(os.path.join(SAVE_PATH, label), exist_ok=True)

# === Initialize MediaPipe ===
mp_hands = mp.solutions.hands
hands = mp_hands.Hands(max_num_hands=1, min_detection_confidence=0.5)
mp_drawing = mp.solutions.drawing_utils

# === Start video capture ===
cap = cv2.VideoCapture(0)

print("Press 's' to start recording, 'q' to quit.")

for label in LABELS:
    sample_count = 0
    while sample_count < 10:  # Number of sequences per gesture
        print(f"Get ready to sign: {label}")
        time.sleep(2)

        keypoint_sequence = []
        start_time = time.time()

        while len(keypoint_sequence) < SEQUENCE_LENGTH:
            ret, frame = cap.read()
            if not ret:
                break

            frame = cv2.flip(frame, 1)
            rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            results = hands.process(rgb_frame)

            if results.multi_hand_landmarks:
                for hand_landmarks in results.multi_hand_landmarks:
                    mp_drawing.draw_landmarks(frame, hand_landmarks, mp_hands.HAND_CONNECTIONS)

                    keypoints = []
                    for lm in hand_landmarks.landmark:
                        keypoints.extend([lm.x, lm.y])

                    keypoint_sequence.append(keypoints)

                    # Display frame count
                    cv2.putText(frame, f"Recording {label}: Frame {len(keypoint_sequence)}/{SEQUENCE_LENGTH}",
                                (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)

            cv2.imshow("Dynamic Sign Collection", frame)
            if cv2.waitKey(1) & 0xFF == ord('q'):
                cap.release()
                cv2.destroyAllWindows()
                exit()

        if len(keypoint_sequence) == SEQUENCE_LENGTH:
            npy_path = os.path.join(SAVE_PATH, label, f"{label}_{sample_count}.npy")
            np.save(npy_path, keypoint_sequence)
            print(f"Saved sequence: {npy_path}")
            sample_count += 1

        time.sleep(1)

cap.release()
cv2.destroyAllWindows()
print("Dynamic gesture collection complete!")
